# Safe development template only. Never commit real credentials or identifiers.
# Copy this file to .env locally, then source secret values from the deployment
# environment or an approved secret manager.

# Docker Compose project and local service configuration
COMPOSE_PROJECT_NAME=marketingos

POSTGRES_DB=marketingos
POSTGRES_USER=marketingos
# REQUIRED SECRET: provide via secret manager or deployment environment.
POSTGRES_PASSWORD=replace-with-a-strong-development-password

# REQUIRED CONNECTION CONFIG: keep credentials in secret manager/deployment environment.
DATABASE_URL=postgresql+asyncpg://marketingos:replace-with-a-strong-development-password@db:5432/marketingos
REDIS_URL=redis://redis:6379/0

# REQUIRED SECRETS: provide via secret manager or deployment environment.
SECRET_KEY=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-an-openai-api-key
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-a-valid-encryption-key

ENVIRONMENT=development
APP_VERSION=0.13H
API_DOCS_ENABLED=false

# Optional Meta integration configuration. Use non-production test credentials only.
# META_APP_SECRET is a secret and must come from secret manager/deployment environment.
META_APP_ID=replace-with-a-meta-app-id
META_APP_SECRET=replace-with-a-meta-app-secret
META_REDIRECT_URI=http://localhost:3100/api/oauth/meta/callback
META_BUSINESS_LOGIN_CONFIG_ID=replace-with-a-meta-business-login-config-id

# Publishing remains fail-closed in this development template.
REAL_PUBLISH_ENABLED=false
META_PUBLISH_TRANSPORT_ENABLED=false
META_PUBLISH_CANARY_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
META_PUBLISH_CANARY_PUBLICATION_ID=00000000-0000-0000-0000-000000000000
META_PUBLISH_CANARY_MODE_ENABLED=true

BACKEND_PORT=8100
FRONTEND_PORT=3100

# Frontend/server runtime configuration
BACKEND_INTERNAL_URL=http://backend:8000
NODE_ENV=development
